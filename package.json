{
  "name": "pharmatree-root",
  "version": "1.0.0",
  "private": true,
  "description": "PharmaTree: Blockchain-Based Pharmaceutical Supply Chain Tracking & Verification System",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=frontend",
    "start": "npm run start --workspace=frontend",
    "lint": "npm run lint --workspace=frontend",
    "compile": "npm --prefix backend run compile",
    "test": "npm --prefix backend test",
    "test:backend": "npm --prefix backend test",
    "test:all": "npm --prefix backend test && npm run build --workspace=frontend",
    "deploy:sepolia": "npm --prefix backend run deploy:sepolia"
  },
  "keywords": [
    "blockchain",
    "pharmaceutical",
    "supply-chain",
    "ethereum",
    "sepolia",
    "solidity",
    "nextjs",
    "hardhat"
  ],
  "author": "Ayon Moitra",
  "license": "MIT"
}
