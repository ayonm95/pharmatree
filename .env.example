# Database & Edge State (Neon Serverless PostgreSQL)
DATABASE_URL=postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require

# Cryptographic Pepper for Tamper Seal HMAC (Keep secret!)
SEAL_PEPPER=your-high-entropy-server-seal-pepper-secret

# Distributed Rate Limiting (Optional: Upstash Redis; falls back to in-memory sliding window)
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# Optional Multi-Tenant API Keys (Comma-separated SHA-256 hashes of authorized tenant keys)
# Format: {"hash1":{"id":"tenant_a","name":"Hospital A","tier":"enterprise","dailyQuota":1000}}
PHARMA_TENANTS_CONFIG=

# IPFS Storage (Server-side only; never expose secret key to browser!)
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_API_KEY=your_pinata_secret_api_key
