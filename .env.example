# Signing Private Keys (Keep strictly private! Never commit real keys)
PRIVATE_KEY=your_local_or_deployer_private_key
SEPOLIA_PRIVATE_KEY_MANUFACTURER=your_manufacturer_private_key
SEPOLIA_PRIVATE_KEY_DISTRIBUTOR=your_distributor_private_key
RELAYER_PRIVATE_KEY=your_unprivileged_hot_relayer_private_key

# Frontend Configuration
NEXT_PUBLIC_PHARMA_TREE_CONTRACT=0xbD245c7f7C8bF4A8Ec016e8C370D3e6931BeAd72
NEXT_PUBLIC_TRUSTED_FORWARDER=0x2d24b5b481d0981AE7904790e9d8BF4c162b6c8c
